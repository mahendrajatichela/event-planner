# ==============================================================
# Event Planner - Contoh Konfigurasi Feature Flags (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilai sesuai kebutuhan.
# ==============================================================

# Modul Navigasi Utama
VITE_FEATURE_EVENTS=true
VITE_FEATURE_CALENDAR=true
VITE_FEATURE_GUESTS=true
VITE_FEATURE_BUDGET=true
VITE_FEATURE_VENDORS=true
VITE_FEATURE_TASKS=true
VITE_FEATURE_REPORTS=true

# Komponen UI & Widget
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_STORAGE_WIDGET=true
VITE_FEATURE_QUICK_ACTIONS=true
