# ==============================================================
# Event Planner - Konfigurasi Feature Flags
# Ubah nilai menjadi 'true' untuk mengaktifkan fitur, atau 'false' untuk menonaktifkan fitur.
# Setelah mengubah file ini, Vite akan otomatis memuat ulang aplikasi.
# ==============================================================

# --- Modul Navigasi & Halaman Acara ---
# Mengaktifkan modul manajemen acara ("Acara Saya")
VITE_FEATURE_EVENTS=true

# Mengaktifkan modul kalender dan jadwal acara
VITE_FEATURE_CALENDAR=true

# Mengaktifkan modul daftar tamu dan RSVP digital
VITE_FEATURE_GUESTS=true

# Mengaktifkan modul pelacakan anggaran dan biaya
VITE_FEATURE_BUDGET=true

# Mengaktifkan modul manajemen vendor dan mitra kerja
VITE_FEATURE_VENDORS=false

# Mengaktifkan modul checklist persiapan dan daftar tugas tim
VITE_FEATURE_TASKS=true

# Mengaktifkan modul laporan statistik dan ekspor data
VITE_FEATURE_REPORTS=true

# --- Komponen UI & Widget ---
# Mengaktifkan lonceng notifikasi dan popover notifikasi di Navbar
VITE_FEATURE_NOTIFICATIONS=true

# Mengaktifkan widget pemakaian kuota dan penyimpanan di Sidebar
VITE_FEATURE_STORAGE_WIDGET=true

# Mengaktifkan tombol aksi cepat "+ Buat Acara" & "Ekspor Laporan"
VITE_FEATURE_QUICK_ACTIONS=true
